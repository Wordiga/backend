# Wordiga → AI 서버 연동 API
#
# 실행 전 준비
# - 기본값은 application.yaml의 AI_SERVER_BASE_URL fallback과 동일합니다.
# - 아래 요청은 Wordiga 소비자 API가 아니라 AiServerClient가 호출하는 내부 연동 계약입니다.

@aiBaseUrl = http://127.0.0.1:8000

### [AI 일정 생성] 선택·지역 후보 콘텐츠를 이용한 일정 생성
POST {{aiBaseUrl}}/api/v1/schedule/generate
Content-Type: application/json

{
  "visit_month": 8,
  "num_people": 4,
  "num_days": 2,
  "num_nights": 1,
  "saved_content_ids": ["126508"],
  "saved_contents": [
    {
      "content_id": "126508",
      "title": "현충사",
      "category": "tourist_spot",
      "address": "충청남도 아산시 염치읍 현충사길 126",
      "latitude": 36.8051452,
      "longitude": 126.9891281,
      "sigungu_code": "200",
      "operating_hours": {
        "open": null,
        "close": null,
        "closed_days": [],
        "raw": "09:00~18:00"
      },
      "tags": ["역사관광", "문화유산"],
      "tel": "041-539-4600",
      "overview": "충무공 이순신 장군의 정신을 기리는 사당입니다.",
      "firstimage": "https://example.com/hyeonchungsa.jpg",
      "avg_visit_duration_min": 90,
      "dist": null,
      "eventstartdate": null,
      "eventenddate": null,
      "is_outdoor": true
    }
  ],
  "regional_contents": [],
  "age_groups": ["20S", "30S"],
  "gender_ratio": null,
  "monthly_weather": {
    "target_month": 8,
    "estimated_average_temperature_celsius": 25.4,
    "estimated_monthly_precipitation_millimeters": 210.5,
    "historical_years": 5,
    "basis": "ASOS_HISTORICAL_MONTHLY_AVERAGE"
  },
  "preferences": null
}

# AiPlanRequest DTO 구조
# {
#   visit_month: int,
#   num_people: int,
#   num_days: int,
#   num_nights: int,
#   saved_content_ids: string[],
#   saved_contents: Content[],
#   regional_contents: Content[],
#   age_groups: string[] | null,
#   gender_ratio: object | null,
#   monthly_weather: MonthlyWeather | null,
#   preferences: object | null
# }
#
# AiPlanResponse DTO 구조
# {
#   schedule_id: long,
#   estimated_budget: {
#     total_amount: long,
#     per_person_amount: long,
#     currency: string,
#     breakdown: { [category: string]: long }
#   } | null,
#   days: [{
#     day_number: int,
#     date: yyyy-MM-dd,
#     contents: [{
#       sequence: int,
#       content_id: string,
#       title: string,
#       content_type_id: string,
#       addr1: string,
#       mapx: decimal,
#       mapy: decimal,
#       start_time: HH:mm,
#       end_time: HH:mm,
#       duration_minutes: int,
#       travel_time_minutes: int,
#       travel_distance_meters: int,
#       estimated_cost: long,
#       memo: string
#     }]
#   }]
# }

### [AI 제안서 생성] 저장 일정 기반 DOCX 생성
POST {{aiBaseUrl}}/internal/v1/proposals
Accept: application/vnd.openxmlformats-officedocument.wordprocessingml.document
Content-Type: application/json

{
  "requestId": "proposal-1",
  "proposalTitle": "아산 워크숍 제안서",
  "organizationName": "Wordiga",
  "purpose": "팀 워크숍",
  "additionalRequest": "일정과 예상 비용을 표로 정리해 주세요.",
  "plan": {
    "planId": 1,
    "scheduleId": 1001,
    "title": "아산 워크숍",
    "startDate": "2026-08-20",
    "endDate": "2026-08-21",
    "participantCount": 4,
    "estimatedBudget": null,
    "days": [],
    "createdAt": "2026-08-18T10:00:00",
    "updatedAt": "2026-08-18T10:00:00"
  },
  "visit_month": 8,
  "num_people": 4
}

# AiProposalRequest DTO 구조
# {
#   requestId: string,
#   proposalTitle: string,
#   organizationName: string,
#   purpose: string,
#   additionalRequest: string,
#   plan: PlanDetailResponse,
#   visit_month: int,
#   num_people: int
# }
# 응답: application/vnd.openxmlformats-officedocument.wordprocessingml.document 바이너리
