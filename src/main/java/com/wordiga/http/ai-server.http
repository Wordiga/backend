# Wordiga → AI 서버 연동 API
#
# 실행 전 준비
# - 기본값은 application.yaml의 AI_SERVER_BASE_URL fallback과 동일합니다.
# - 아래 요청은 Wordiga 소비자 API가 아니라 AiServerClient가 호출하는 내부 연동 계약입니다.

@aiBaseUrl = http://127.0.0.1:8000

### [AI 일정 생성] 선택·지역 후보 콘텐츠를 이용한 일정 생성
POST {{aiBaseUrl}}/api/v1/schedule/generate
Content-Type: application/json

{
  "plan_id": 1001,
  "visit_month": 8,
  "num_people": 10,
  "num_days": 2,
  "num_nights": 1,
  "saved_content_ids": ["126508"],
  "saved_contents": [
    {
      "content_id": "126508",
      "title": "현충사",
      "category": "tourist_spot",
      "address": "충청남도 아산시 염치읍 현충사길 126",
      "latitude": 36.8051452,
      "longitude": 126.9891281,
      "sigungu_code": "200",
      "operating_hours": {
        "open": null,
        "close": null,
        "closed_days": [],
        "raw": "09:00~18:00"
      },
      "tags": ["역사관광", "문화유산"],
      "tel": "041-539-4600",
      "overview": "충무공 이순신 장군의 정신을 기리는 사당입니다.",
      "firstimage": "https://example.com/hyeonchungsa.jpg",
      "avg_visit_duration_min": 90,
      "dist": null,
      "eventstartdate": null,
      "eventenddate": null,
      "is_outdoor": true
    }
  ],
  "regional_contents": [],
  "age_groups": ["20S", "30S"],
  "gender_ratio": null,
  "monthly_weather": {
    "target_month": 8,
    "estimated_average_temperature_celsius": 25.4,
    "estimated_monthly_precipitation_millimeters": 210.5,
    "historical_years": 5,
    "basis": "ASOS_HISTORICAL_MONTHLY_AVERAGE"
  },
  "preferences": null
}

# AiPlanRequest DTO 구조
# {
#   plan_id: long,
#   visit_month: int (1..12),
#   num_people: int (10..50),
#   num_days: int,
#   num_nights: int,
#   saved_content_ids: string[],
#   saved_contents: Content[],
#   regional_contents: Content[],
#   age_groups: string[] | null,
#   gender_ratio: object | null,
#   monthly_weather: MonthlyWeather | null,
#   preferences: object | null
# }
#
# AiPlanResponse DTO 구조
# {
#   plan_id: long,
#   status: string,
#   timetable: {
#     total_days: int,
#     total_travel_time_min: int,
#     days: [{
#       day: int,
#       date_label: string,
#       items: [{
#       order: int,
#       content_id: string,
#       title: string,
#       category: string,
#       latitude: decimal,
#       longitude: decimal,
#       start_time: HH:mm,
#       end_time: HH:mm,
#       travel_time_from_prev_min: int,
#       memo: string
#       }]
#     }]
#   },
#   warnings: string[]
# }

### [AI 제안서 생성] 저장 일정 기반 DOCX 생성
POST {{aiBaseUrl}}/api/v1/proposal/generate?format=docx
Accept: application/vnd.openxmlformats-officedocument.wordprocessingml.document
Content-Type: application/json

{
  "plan_id": 1,
  "company_info": {
    "company_name": "Wordiga"
  },
  "timetable": {
    "total_days": 2,
    "total_travel_time_min": 0,
    "days": []
  },
  "estimated_budget": null,
  "workshop_purpose": "팀 워크숍",
  "visit_month": 8,
  "num_people": 10
}

# AiProposalRequest DTO 구조
# {
#   plan_id: long,
#   company_info: { company_name: string },
#   timetable: object,
#   estimated_budget: { total, per_person, breakdown } | null,
#   workshop_purpose: string | null,
#   visit_month: int,
#   num_people: int
# }
# 응답: application/vnd.openxmlformats-officedocument.wordprocessingml.document 바이너리
